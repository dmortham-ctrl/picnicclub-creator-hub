NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase's newer dashboard may call the same public key publishable_key.
# Use either name, not both.

# Only for running database migrations locally (npm run db:migrate).
# Personal access token from https://supabase.com/dashboard/account/tokens
# Keep this out of the client bundle - it is never referenced by app code.
SUPABASE_ACCESS_TOKEN=
